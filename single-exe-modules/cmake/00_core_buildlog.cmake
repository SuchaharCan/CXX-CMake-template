# =============================================================================
# 00_core_buildlog.cmake — 构建输出管道（tee 日志 + grc 着色 + 长命令换行）
# 分层: core（必选）
# 独立: 否
# 上游: 00_core_color.cmake（CXX_GRC_<名称> 生成 build/cxx_grc.conf）
#       00_core_log.cmake（CXX_LOG_DIR / cmake_build.log）
# 下游: 10_core_setup.cmake（cxx_install_build_tool_tee）
#       00_core_lint.cmake（cxx_build_log_echo_commands 门禁提示）
# 功能:
#   - 把 CMAKE_MAKE_PROGRAM 换成 build/cxx_build_tee：tee 到 log + 终端着色
#   - 着色引擎 = grcat（brew install grc）+ 由 cxx.palette 生成的 conf
#   - 长命令（>160 字符且 ≥4 个 -flag）在终端按参数换行（cxx_build_colorize.inc.sh）
#   - 日志保持纯文本单行原文；非 TTY 不着色（可用 CLICOLOR_FORCE 覆盖）
# =============================================================================

include_guard(GLOBAL)

set(CXX_BUILD_META_DIR "${CMAKE_BINARY_DIR}/.cxx_build_meta")
set(CXX_BUILD_COLORIZE_INC "${CMAKE_CURRENT_LIST_DIR}/cxx_build_colorize.inc.sh"
    CACHE INTERNAL "Terminal colorize helper sourced by cxx_build_tee")
set(CXX_BUILDLOG_MODULE "${CMAKE_CURRENT_LIST_DIR}/00_core_buildlog.cmake"
    CACHE INTERNAL "build log module path (functions 内 CMAKE_CURRENT_LIST_DIR 指向调用方)")
set(CXX_HIGHLIGHT_RULES "${CMAKE_CURRENT_LIST_DIR}/cxx_highlight.rules"
    CACHE INTERNAL "build output highlight rules table")

if(NOT DEFINED CXX_BUILD_LOG_MAX_LINES)
  set(CXX_BUILD_LOG_MAX_LINES "5000" CACHE STRING
      "Max lines kept in log/cmake_build.log (full cmake --build output)")
endif()

# -----------------------------------------------------------------------------
# cxx_build_log_echo_commands(out_var message)
# 作用：format/tidy gate 等短提示（淡黄）；落盘靠 tee，此处只打终端。
# -----------------------------------------------------------------------------
function(cxx_build_log_echo_commands out_var message)
  set(${out_var}
    COMMAND "${CMAKE_COMMAND}"
      "-DLOG_FILE=${CXX_LOG_DIR}/cmake_build.log"
      "-DMAX_LINES=${CXX_BUILD_LOG_MAX_LINES}"
      "-DMESSAGE=${message}"
      "-DPHASE=ECHO"
      -P "${CXX_BUILDLOG_MODULE}"
    PARENT_SCOPE)
endfunction()

# -----------------------------------------------------------------------------
# cxx_generate_grc_conf()
# 作用：读取 cmake/cxx_highlight.rules 规则表，映射 cxx.palette 颜色，
#       生成 build/cxx_grc.conf（grcat 构建输出着色规则）。
#       新增关键字 → 只需在 cxx_highlight.rules 加一行。
# -----------------------------------------------------------------------------
function(cxx_generate_grc_conf)
  set(_conf "${CMAKE_BINARY_DIR}/cxx_grc.conf")
  set(_rules_file "${CXX_HIGHLIGHT_RULES}")
  set(_out "# generated by 00_core_buildlog.cmake from cmake/cxx_highlight.rules + cxx.palette\n")
  if(EXISTS "${_rules_file}")
    file(STRINGS "${_rules_file}" _rule_lines ENCODING UTF-8)
    foreach(_line IN LISTS _rule_lines)
      string(STRIP "${_line}" _line)
      if(_line STREQUAL "" OR _line MATCHES "^[ \t]*#([ \t]|$)")
        continue()
      endif()
      string(REGEX REPLACE "^[ \t]*([^|]+)[ \t]*[|][ \t]*(.*)$" "\\1" _pat "${_line}")
      string(REGEX REPLACE "^[ \t]*[^|]+[ \t]*[|][ \t]*(.*)$" "\\1" _rest "${_line}")
      string(STRIP "${_pat}" _pat)
      string(STRIP "${_rest}" _rest)
      set(_count "more")
      if(_rest MATCHES "[|]")
        string(REGEX REPLACE "^[ \t]*([a-z_]+)[ \t]*[|][ \t]*(.*)$" "\\1" _color "${_rest}")
        string(REGEX REPLACE "^[ \t]*[a-z_]+[ \t]*[|][ \t]*(.*)$" "\\1" _count "${_rest}")
      else()
        set(_color "${_rest}")
      endif()
      string(STRIP "${_color}" _color)
      string(STRIP "${_count}" _count)
      if(DEFINED CXX_GRC_${_color})
        set(_grc "${CXX_GRC_${_color}}")
      else()
        cxx_msg(yellow "cxx_highlight.rules: unknown color '${_color}' (pattern '${_pat}') — skipped")
        continue()
      endif()
      string(APPEND _out
        "regexp=${_pat}\ncolours=${_grc}\ncount=${_count}\n-\n")
    endforeach()
  endif()
  file(WRITE "${_conf}" "${_out}")
  set(CXX_GRC_CONF "${_conf}" CACHE FILEPATH "grcat conf for build output" FORCE)
endfunction()

# -----------------------------------------------------------------------------
# cxx_install_build_tool_tee()
# 作用：project() 之后安装 make/ninja 包装，实现 tee + grc 着色 + 换行格式化。
# -----------------------------------------------------------------------------
function(cxx_install_build_tool_tee)
  set(_gen "${CMAKE_GENERATOR}")
  if(NOT _gen MATCHES "Ninja" AND NOT _gen STREQUAL "Unix Makefiles")
    if(COMMAND cxx_msg)
      cxx_msg(warning "build tee: skip (generator ${_gen}; want Ninja or Unix Makefiles)")
    endif()
    return()
  endif()

  set(_wrap "${CMAKE_BINARY_DIR}/cxx_build_tee")
  set(_already_wrapped FALSE)
  if(CMAKE_MAKE_PROGRAM MATCHES "cxx_build_tee$" AND EXISTS "${CMAKE_MAKE_PROGRAM}")
    set(_already_wrapped TRUE)
  endif()

  set(_real "")
  if(DEFINED CACHE{CXX_REAL_BUILD_TOOL} AND EXISTS "${CXX_REAL_BUILD_TOOL}"
      AND NOT CXX_REAL_BUILD_TOOL MATCHES "cxx_build_tee")
    set(_real "${CXX_REAL_BUILD_TOOL}")
  elseif(NOT _already_wrapped AND CMAKE_MAKE_PROGRAM
         AND NOT CMAKE_MAKE_PROGRAM MATCHES "cxx_build_tee")
    set(_real "${CMAKE_MAKE_PROGRAM}")
  elseif(_gen MATCHES "Ninja")
    find_program(_real NAMES ninja ninja-build REQUIRED)
  else()
    find_program(_real NAMES make gmake REQUIRED)
  endif()
  set(CXX_REAL_BUILD_TOOL "${_real}" CACHE FILEPATH
      "Real make/ninja behind cxx_build_tee" FORCE)

  # grc 着色引擎（可选：缺失时仍保留换行格式化，仅不着色）
  find_program(CXX_GRCAT grcat)
  cxx_generate_grc_conf()

  set(_log "${CXX_LOG_DIR}/cmake_build.log")
  set(_max "${CXX_BUILD_LOG_MAX_LINES}")
  set(_color_inc "${CXX_BUILD_COLORIZE_INC}")
  set(_grc_conf "${CXX_GRC_CONF}")
  set(_src_dir "${CMAKE_SOURCE_DIR}")
  set(_bin_dir "${CMAKE_BINARY_DIR}")

  file(WRITE "${_wrap}" "#!/usr/bin/env bash
# Auto-generated by 00_core_buildlog.cmake — do not edit
set -o pipefail
LOG=\"${_log}\"
REAL=\"${CXX_REAL_BUILD_TOOL}\"
MAX_LINES=${_max}
COLOR_INC=\"${_color_inc}\"
export CXX_GRC_CONF=\"${_grc_conf}\"
export CXX_GRCAT=\"${CXX_GRCAT}\"
export CXX_SRC_DIR=\"${_src_dir}\"
export CXX_BIN_DIR=\"${_bin_dir}\"

if [[ \$# -eq 1 && \$1 == --version ]]; then
  exec \"\$REAL\" --version
fi

# shellcheck source=cxx_build_colorize.inc.sh
source \"\$COLOR_INC\"

mkdir -p \"\$(dirname \"\$LOG\")\"
{
  printf '===== %s cmake --build =====\\n' \"\$(date '+%Y-%m-%d %H:%M:%S')\"
  \"\$REAL\" \"\$@\"
} 2>&1 | tee -a \"\$LOG\" | _cxx_colorize
rc=\${PIPESTATUS[0]}
if [[ -f \"\$LOG\" ]] && command -v tail >/dev/null; then
  tmp=\"\${LOG}.trim\"
  tail -n \"\$MAX_LINES\" \"\$LOG\" > \"\$tmp\" && mv \"\$tmp\" \"\$LOG\"
fi
exit \"\$rc\"
")
  file(CHMOD "${_wrap}" PERMISSIONS
    OWNER_READ OWNER_WRITE OWNER_EXECUTE
    GROUP_READ GROUP_EXECUTE
    WORLD_READ WORLD_EXECUTE)

  set(CMAKE_MAKE_PROGRAM "${_wrap}" CACHE FILEPATH
      "Build tool wrapper: tee + grc colorize + reflow" FORCE)

  if(COMMAND cxx_msg)
    cxx_msg(grass "build tee+grc: ${CMAKE_MAKE_PROGRAM} → ${_log}")
  endif()
endfunction()

if(CMAKE_SCRIPT_MODE_FILE AND DEFINED PHASE)
  if(PHASE STREQUAL "ECHO")
    if(DEFINED MESSAGE)
      message(STATUS "${MESSAGE}")
    endif()
  endif()
endif()
