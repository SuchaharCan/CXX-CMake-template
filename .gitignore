# ---> 模板本地构建产物与场景日志（勿提交）
templates/**/build/
templates/**/build-*/
templates/**/log/
# 允许模板用 .gitkeep 保留 log/ 目录结构（运行日志仍全部忽略）
!templates/**/log/
templates/**/log/*
!templates/**/log/.gitkeep
templates/**/.cache/
templates/**/.cxx_build_meta/
templates/**/*.pak
templates/**/*.zip
templates/**/cxx_build_tee
templates/**/cxx_ninja_tee


