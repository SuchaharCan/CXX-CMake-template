# =============================================================================
# justfile — Omni-Stacks / Stacks_Tools（多静态 C++ 模块 + 单 main）
# 仅保留 macOS 支持的工具链；所有编译型 recipe 共享 ccache 和同一 build/。
# =============================================================================

set shell := ["bash", "-cu"]
set export
unexport CCACHE_DISABLE

# ---- 固定构建契约 ---------------------------------------------------------
CXX_PREFERRED_COMPILER := env_var_or_default("CXX_PREFERRED_COMPILER", "auto")
CXX_STDLIB := env_var_or_default("CXX_STDLIB", "auto")
CXX_BQLOG_MODE := "module"
CXX_ENABLE_CCACHE := "ON"
CCACHE_DIR := justfile_directory() + "/build/.ccache"
CCACHE_TEMPDIR := justfile_directory() + "/build/.ccache/tmp"
CLICOLOR_FORCE := "1"
CXX_BUILD_COLOR_FORCE := "1"
JUST_COMMAND_COLOR := "yellow"
clang_format := env_var_or_default("CLANG_FORMAT", "clang-format")
cxx_compiler := env_var_or_default("CXX_PREFERRED_COMPILER", "auto")
cxx_stdlib := env_var_or_default("CXX_STDLIB", "auto")
toolchain_flags := "-DCXX_PREFERRED_COMPILER=" + cxx_compiler + " -DCXX_STDLIB=" + cxx_stdlib + " -DCXX_ENABLE_CCACHE=ON"

# ---- 本地运行/CI 可覆盖参数 ----------------------------------------------
builddir := "build"
jobs := env_var_or_default("JOBS", num_cpus())
# Alfred workflow 路径由 HOME 派生；用户可用 STACKS_WORKFLOW_DIR 指向其他安装。
default_workflow_dir := env_var_or_default("STACKS_WORKFLOW_DIR", env_var("HOME") + "/Library/Application Support/Alfred/Alfred.alfredpreferences/workflows/user.workflow.55BE3092-6341-4EB7-8A16-0AD3648B7B73")

default: build

# 命令列表
list:
    # 保留 just 原生列表，仅给注释加黄色高亮。
    just --list --color always | perl -ne 'if (/(.*?)(#.*)/) { ($a,$c)=($1,$2); $c =~ s/\e\[[0-9;]*m//g; print "$a\e[1;33m$c\e[0m\n"; } else { print; }'

# 必选环境变量
env:
    @echo "CXX_PREFERRED_COMPILER  = {{CXX_PREFERRED_COMPILER}}"
    @echo "CXX_STDLIB              = {{CXX_STDLIB}}"
    @echo "CXX_BQLOG_MODE          = module"
    @echo "CXX_ENABLE_CCACHE       = {{CXX_ENABLE_CCACHE}}"
    @echo "JOBS                    = {{jobs}}"
    @echo "STACKS_WORKFLOW_DIR     = {{default_workflow_dir}}"

# 构建环境与预期工具版本
doctor:
    @echo "cmake: $(cmake --version | head -1)"
    @echo "clang: $(clang++ --version | head -1)"
    @echo "ninja: $(ninja --version)"
    @echo "just:  $(just --version)"
    @echo "jq:    $(jq --version)"
    @test -x /usr/bin/osascript && echo "osascript: ok"

# 配置（auto 在 macOS = clang++ + libc++）；*ARGS 可覆盖任意 CMake option。
configure *ARGS:
    cmake -S . -B {{builddir}} -G Ninja -DCMAKE_BUILD_TYPE=RelWithDebInfo {{toolchain_flags}} {{ARGS}}

# 基础构建；clang-format gate 由 CMake 判定，关闭时不执行自动格式化。
build: configure
    @if grep -q '^CXX_ENABLE_CLANG_FORMAT:BOOL=ON' {{builddir}}/CMakeCache.txt; then just fmt; else echo "clang-format disabled, skip auto-fmt"; fi
    cmake --build {{builddir}} -j{{jobs}}
    @just ccache-stats

# 显式 clang++ + libc++ 构建
build-clang:
    CXX_LIBCXX_DEPS_PREFIX="{{justfile_directory()}}/../.deps-libcxx" cmake -S . -B build/clang -G Ninja -DCMAKE_BUILD_TYPE=RelWithDebInfo -DCXX_PREFERRED_COMPILER=clang++ -DCXX_STDLIB=libc++ -DCXX_ENABLE_CCACHE=ON
    cmake --build build/clang -j{{jobs}}
    @just ccache-stats

# 源码自动格式化（含 .cppm）
fmt:
    find modules src tests \( -path tests/.runtime -o -path tests/logs \) -prune -o -type f \( -name '*.cxx' -o -name '*.hxx' -o -name '*.cpp' -o -name '*.hpp' -o -name '*.cppm' \) -exec {{clang_format}} -i --style=file:cmake/.clang-format {} +
    @which shellcheck >/dev/null 2>&1 && shellcheck scripts/*.sh tests/*.sh || true

# 使用 macOS SF Symbols 生成插件内项目/清单/任务/Note 图标
icons:
    swift scripts/generate-icons.swift
    @ls -lh icons/*.png

# 语法与构建检查
check: build
    @if cmake --build {{builddir}} --target help | grep -q "tidy-check"; then cmake --build {{builddir}} --target tidy-check; else echo "tidy-check skipped (module-only targets)"; fi
    cmake --build {{builddir}} --target syntax-check
    @just ccache-stats

# 单元测试：工作区固定写入 tests/.runtime，日志写入 tests/logs
test:
    mkdir -p tests/.runtime tests/logs
    cmake -S . -B {{builddir}} -G Ninja -DCMAKE_BUILD_TYPE=Debug {{toolchain_flags}} -DCXX_ENABLE_GTEST=ON
    cmake --build {{builddir}} --target static_modules_tests -j{{jobs}}
    set -o pipefail; ctest --test-dir {{builddir}} -j{{jobs}} --output-on-failure 2>&1 | tee tests/logs/unit-tests.log
    @just ccache-stats

# CTest 并行执行 + 并发测试
parallel-test:
    mkdir -p tests/.runtime tests/logs
    cmake -S . -B {{builddir}} -G Ninja -DCMAKE_BUILD_TYPE=Debug {{toolchain_flags}} -DCXX_ENABLE_GTEST=ON
    cmake --build {{builddir}} --target static_modules_tests -j{{jobs}}
    set -o pipefail; ctest --test-dir {{builddir}} -j{{jobs}} --output-on-failure 2>&1 | tee tests/logs/parallel-tests.log
    @just ccache-stats

# 变异测试：源码内隔离目录，日志 tests/logs/mutation.log
mutation-test:
    mkdir -p tests/.runtime tests/logs
    set -o pipefail; bash tests/run_mutation_tests.sh 2>&1 | tee tests/logs/mutation.log
    @just ccache-stats

# AppleScript 字典编译校验（不执行外部同步）
applescript-check: build
    bash tests/check_applescripts.sh

# 真实 Stacks 数据隔离副本 CRUD 烟测
real-data-smoke library="": build
    @if [[ -z "{{library}}" ]]; then echo "usage: just real-data-smoke /path/to/StacksLibrary"; exit 2; fi
    set -o pipefail; bash tests/real_data_smoke.sh "{{library}}" 2>&1 | tee tests/logs/real-data-smoke.log

# 空白 Alfred workflow 中的安装布局、备份和旧数据迁移测试
install-layout-test: build
    mkdir -p tests/.runtime tests/logs
    set -o pipefail; bash tests/install_layout_smoke.sh 2>&1 | tee tests/logs/install-layout.log

# CLI + Alfred JSON 烟测（不写真实 Stacks 数据）
smoke: build
    @set -o pipefail; ./build/Stacks_Tools ui "" | sed '/\[Bq\]/d' | jq -e '.items | length > 0' >/dev/null
    @set -o pipefail; ./build/Stacks_Tools ui "inbox smoke" | sed '/\[Bq\]/d' | jq -e '.items[0].title | contains("收件箱")' >/dev/null
    @./build/Stacks_Tools boards
    @echo "smoke ok"

# 注释文档生成：clang-doc 读 compile_commands，Doxygen 使用 DESIGN_DOC 作为主页。
docs:
    cmake -S . -B {{builddir}} -G Ninja -DCMAKE_BUILD_TYPE=RelWithDebInfo {{toolchain_flags}} -DCXX_ENABLE_DOCS=ON
    cmake --build {{builddir}} --target docs
    @bash "{{justfile_directory()}}/cmake/report_docs_links.sh" "{{builddir}}"

# C++ 函数调用/被调用关系图
uml:
    cmake -S . -B {{builddir}} -G Ninja -DCMAKE_BUILD_TYPE=RelWithDebInfo {{toolchain_flags}} -DCXX_ENABLE_DOCS=ON
    cmake --build {{builddir}} --target docs-doxygen
    @printf '\n函数调用关系图：%s/%s/docs/doxygen/html/index.html\n' "{{justfile_directory()}}" "{{builddir}}"

# 本地 CI 复现（功能等价于原模板 workflow 矩阵入口）
local-ci: fmt
    just build
    just test
    just mutation-test
    just install-layout-test
    just smoke
    just package

# 生成无源码 Alfred workflow 包；stage 先由 layout 测试验证，再检查 package 不含 data/log。
package: build
    bash scripts/package-workflow.sh
    @bash tests/check_workflow_layout.sh dist/Omni-Stacks package
    @set -o pipefail; bash tests/package_first_run_smoke.sh 2>&1 | tee tests/logs/package-first-run.log

# 安装到当前 Alfred workflow；默认路径可用 STACKS_WORKFLOW_DIR 覆盖。
# install-workflow 负责 staging、备份和数据迁移，随后立即跑 Script Filter 自检。
install workflow_dir=default_workflow_dir: build
    bash scripts/install-workflow.sh "{{workflow_dir}}"
    @STACKS_WORKFLOW_DIR="{{workflow_dir}}" "{{workflow_dir}}/Stacks_Tools" ui "" | sed '/\[Bq\]/d' | jq -e '.items | length > 0' >/dev/null
    @echo "install ok: {{workflow_dir}}"

# 安装后自检
verify-install workflow_dir=default_workflow_dir:
    @bash tests/check_workflow_layout.sh "{{workflow_dir}}"
    @plutil -lint "{{workflow_dir}}/info.plist"
    @STACKS_WORKFLOW_DIR="{{workflow_dir}}" "{{workflow_dir}}/Stacks_Tools" ui "" | sed '/\[Bq\]/d' | jq -e '.items | length > 0' >/dev/null
    @echo "verify-install ok"

# 只读检查真实工作区 JSON 与任务索引
verify-data workflow_dir=default_workflow_dir:
    @jq -e . "{{workflow_dir}}/data/Project.json" >/dev/null
    @jq -e . "{{workflow_dir}}/data/Stack.json" >/dev/null
    @jq -e . "{{workflow_dir}}/data/Timers.json" >/dev/null
    @echo "data json ok"

# 独立 ccache 统计
ccache-stats:
    @printf '\n\033[1;33m━━━━━━━━━━━━━━━━━━━━  ccache 缓存使用统计  ━━━━━━━━━━━━━━━━━━━━\033[0m\n'
    @if command -v ccache >/dev/null 2>&1; then \
      if command -v timeout >/dev/null 2>&1; then \
        timeout 5s ccache --show-stats --verbose || \
          echo "ccache 统计超过 5 秒或不可用，已跳过（不影响构建/测试）"; \
      elif command -v gtimeout >/dev/null 2>&1; then \
        gtimeout 5s ccache --show-stats --verbose || \
          echo "ccache 统计超过 5 秒或不可用，已跳过（不影响构建/测试）"; \
      else \
        echo "系统没有 timeout/gtimeout，已跳过 ccache 统计（不影响构建/测试）"; \
      fi; \
    else \
      echo "ccache 未安装，无法显示缓存统计"; \
    fi

# 清理构建与打包生成物（保留测试日志和用户数据）
clean:
    cmake -E remove_directory {{builddir}}
    cmake -E remove_directory dist
