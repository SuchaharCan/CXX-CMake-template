# Doxyfile.in — 由 cmake/92_opt_docs.cmake 在 configure 时展开
# 设计文档（DESIGN_DOC.md）作为 HTML 主页。
PROJECT_NAME           = "@PROJECT_NAME@"
PROJECT_NUMBER         = "@PROJECT_VERSION@"
OUTPUT_DIRECTORY       = "@CMAKE_BINARY_DIR@/docs/doxygen"
INPUT                  = "@CMAKE_SOURCE_DIR@/src" \
                         "@CMAKE_SOURCE_DIR@/modules" \
                         "@CMAKE_SOURCE_DIR@/docs"
FILE_PATTERNS          = *.cxx *.cpp *.h *.hxx *.hpp *.cppm *.md
RECURSIVE              = YES
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_ANON_NSPACES   = YES
EXTENSION_MAPPING      = cppm=C++
SOURCE_BROWSER         = YES
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_XML           = YES
XML_OUTPUT             = xml
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
EXCLUDE                = "@CMAKE_SOURCE_DIR@/json.hpp"
HAVE_DOT               = YES
DOT_IMAGE_FORMAT       = svg
DOT_NUM_THREADS        = 8
DOT_CLEANUP            = NO
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
HTML_OUTPUT            = html
USE_MDFILE_AS_MAINPAGE = "@CMAKE_SOURCE_DIR@/docs/DESIGN_DOC.md"
